# dependencies
node_modules/
.pnp
.pnp.*

# build output — ANCHORED to the repo root on purpose.
# An unanchored `build/` matches a directory named "build" at ANY depth, which
# silently swallowed real source: src/app/build/ (the /build route) and
# src/app/components/build/. Two commits claimed to ship that route and shipped
# nothing, because git was never asked about files it had been told to ignore.
/build/
/dist/
.next/
out/

# environment — never commit real keys (NVIDIA_API_KEY, UPSTASH_*, VERCEL_API_TOKEN…)
.env
.env.*
!.env.example

# vercel
.vercel/

# testing / coverage
coverage/

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.idea/
*.tsbuildinfo
next-env.d.ts

# Throwaway verification probes. `ops/*.test.mjs` and `ops/*.browser.mjs` are the
# real suites and stay tracked; anything named `_tmp_*` is a one-off written to
# measure a single finding in a browser and is meant to be deleted after.
#
# ANCHORED, following the lesson recorded above about `/build/`: an unanchored
# pattern here would also swallow a legitimately-named file elsewhere in the tree.
#
# 21 of these reached commits f8db092..cdec754 via `git add -A` before this rule
# existed. They are untracked in the same commit that adds it.
/src/ops/_tmp_*
